# Copy to .env and fill in. All values below are placeholders.

# ── Postgres (SIT) ───────────────────────────────────────────
POSTGRESQL_USER=
POSTGRESQL_HOST=<postgres-host>
POSTGRESQL_DATABASE=<database>
POSTGRESQL_PASSWORD=
POSTGRESQL_PORT=5432
POSTGRESQL_SSL=true
ENVIRONMENT=prod

# ── Firebase Auth allowlist ─────────────────────────────────
# Project ID is auto-detected at runtime — do NOT add a FIREBASE_*-prefixed
# var here (the Functions runtime reserves that prefix).
#
# Comma-separated allowlist. Only these Google-authenticated emails get
# through the auth middleware.
ALLOWED_EMAILS=<email-1>,<email-2>

# ── Misc ─────────────────────────────────────────────────────
# CORS origin for the hosted dashboard. Use the Firebase Hosting URL.
DASHBOARD_ORIGIN=https://bhookle-qa.web.app

# Shared secret used by the test-case-generator skill helpers (refine flow)
# to call the BE from a dev machine without Firebase sign-in. Generate
# with: openssl rand -hex 32. Keep matching values in the BE env AND in
# ~/.claude/skills/test-case-generator/.env on the dev machine.
QA_CLI_TOKEN=

# ── CI run orchestration (GitHub Actions device matrix) ─────
# HMAC key used to mint per-run callback tokens (>= 32 chars). openssl rand -hex 32
CALLBACK_HMAC_KEY=
# Public base URL of this function, used to build the CI callback URL
CALLBACK_BASE_URL=https://<region>-<your-project>.cloudfunctions.net/bhookleQaBackend/api-cb/runs
# Fine-grained PAT scoped to ONE repo with actions:write only (workflow_dispatch)
GH_PAT_DISPATCH=
GH_OWNER=<github-owner>
GH_REPO=device-matrix-harness
GH_WORKFLOW_FILE=run-suite.yml
GH_REF=main

# ── CLI helpers (scripts/*.js, skill helpers) ───────────────
QA_API_BASE=https://<region>-<your-project>.cloudfunctions.net/bhookleQaBackend

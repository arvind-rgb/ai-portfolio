# Copy to .env and fill in. Every key is optional — without them the app still
# runs (AI drafting falls back to your base templates, sending is disabled).

# Claude — personalised email / LinkedIn drafting, template rewriting, rejection classification
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Gemini (Google-grounded search) — lead discovery, investor classification, enrichment
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: LinkedIn session cookie, used only to read a KNOWN profile's contact overlay
LINKEDIN_LI_AT=your-linkedin-li_at-cookie-here

# Gmail SMTP sending (Google "App Password", not your login password)
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Flask
SECRET_KEY=change-me
PORT=5050
FLASK_DEBUG=0

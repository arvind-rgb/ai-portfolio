# ShipHop.AI server config. Copy to .env and fill in. .env is gitignored.
#
# Fastest way to look around: `npm run demo` — needs NONE of this (it generates
# throwaway values and seeds demo data).

# HTTP port (hosts inject PORT automatically; default 8787).
PORT=8787

# --- Database ---
# Postgres. When set, sessions + bookings + tenants persist to booker_* tables
# (migration auto-runs on boot). When unset, a JSON file store is used.
# DATABASE_URL=<your-postgres-connection-string>

# --- Credential encryption (required before storing real courier sessions) ---
# 32 bytes, base64 or hex. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it stable: rotating it forces every courier to reconnect.
# BOOKER_CRED_KEY=<32-byte-base64>

# --- Auth ---
# Signs tenant + admin JWTs. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# BOOKER_JWT_SECRET=<random-string>

# Admin console (create tenants + operator logins at /admin).
# BOOKER_ADMIN_EMAIL=admin@example.com
# BOOKER_ADMIN_PASSWORD=<choose-one>

# Require operator login (no single-tenant bootstrap). Set to 1 in production.
# BOOKER_DISABLE_BOOTSTRAP=1

# --- Google Places (address autocomplete; server-side proxy) ---
# Unset → a small built-in demo address book is used.
# GOOGLE_MAPS_API_KEY=<your-key>

# --- Mock adapter tuning ---
# Seconds between simulated status steps (Booked → … → Delivered).
# MOCK_STEP_SECONDS=30

# Placeholders only. Real values live in a local .env (git-ignored) and in GitHub Actions secrets.

# --- AI generation (social-create, email-outreach hero images) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- Asset hosting (social-post, email-outreach) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Instagram / Facebook (social-post, perf writeback) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_PAGE_ID=

# --- LinkedIn (social-post) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LI_ACCESS_TOKEN=
LI_AUTHOR_URN=urn:li:person:<PERSON_ID>
LI_COMPANY_URN=urn:li:organization:<COMPANY_ID>

# --- Push notifications (bhookle-notify) ---
# Raw JSON of a Firebase service account with FCM send permission (GitHub secret), or a local file path.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
NOTIF_CALENDAR_PATH=notifications/notification-calendar.json
RUNWAY_THRESHOLD=5

# --- Email (email-outreach) ---
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM_EMAIL=team@example.com
EMAIL_FROM_NAME=
EMAIL_RECIPIENT=owner@example.com
EMAIL_ADMIN_RECIPIENT=owner@example.com

# --- Lemlist (lemlist-ops) ---
LEMLIST_API_KEY=
LEMLIST_REPORT_RECIPIENT=owner@example.com

# --- Meta Ads (ads-manager) ---
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=<AD_ACCOUNT_ID>
ADS_REPORT_RECIPIENT=owner@example.com
WALLET_ALERT_THRESHOLD_INR=
LEAD_FORM_IDS=
LEAD_CAMPAIGN_IDS=
LEADS_RECIPIENT=ops@example.com

# --- Report / digest mail (Gmail SMTP with an app password) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
